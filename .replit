# Replit configuration for "Sensationalize Science" (paper2video)
# This file is ADDITIVE and does not affect local `npm run dev`.
# Docs: https://docs.replit.com/replit-workspace/configuring-repl

# Bind Next.js dev server to 0.0.0.0 so Replit's webview can reach it.
# We pass flags via `npm run dev -- ...` so package.json stays untouched.
run = "npm run dev -- -H 0.0.0.0 -p 3000"
entrypoint = "app/page.tsx"

# Tell Replit's package guardian to leave our lockfile-driven install alone.
hidden = [".next", "node_modules", ".config"]

[nix]
channel = "stable-24_05"

[env]
# Next.js reads PORT; keep it aligned with the run command and port mapping.
PORT = "3000"
NEXT_TELEMETRY_DISABLED = "1"

# Map the internal dev port to the public URL Replit exposes.
[[ports]]
localPort = 3000
externalPort = 80

# First-boot / dependency install helper (run manually from the Shell if needed):
#   npm install
# Native modules (better-sqlite3, sharp, @napi-rs/canvas) compile against the
# libs declared in replit.nix.

# Optional: production-style deploy target. Collaboration only needs `run` above.
[deployment]
build = ["sh", "-c", "npm install && npm run build"]
run = ["sh", "-c", "npm run start -- -H 0.0.0.0 -p 3000"]
deploymentTarget = "cloudrun"
