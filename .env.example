# ---- Claude (script generation) ----
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# Optional: model used for scientific figure analysis and ranking.
# Needs vision. Defaults to claude-sonnet-4-5-20250929.
# FIGURE_ANALYSIS_MODEL=claude-sonnet-4-5-20250929

# ---- ElevenLabs (narration audio for the rendered video) ----
# https://elevenlabs.io -> Profile -> API Keys
ELEVENLABS_API_KEY=
# A voice ID from your ElevenLabs voice library
ELEVENLABS_VOICE_ID=
# Optional: ElevenLabs voice_settings.speed (default 1.0)
# ELEVENLABS_SPEED=1.0
# Optional: post-TTS ffmpeg speedup (default 1.2 ≈ 20% slower than older 1.5)
# NARRATION_SPEED=1.2

# ---- Google Gemini (AI scene illustrations) ----
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: override the image model (default: gemini-2.5-flash-image)
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# ---- Rendering (optional performance tuning) ----
# Output resolution scale, 1.0 = full 1080p (default 0.5 = 540x960)
# RENDER_SCALE=0.5
# Parallel Remotion render workers (default 1)
# RENDER_CONCURRENCY=1
# ffmpeg thread count during muxing (default 2)
# FFMPEG_THREADS=2

# ---- Auth (sessions) ----
# Random string, at least 16 chars. Required in production.
AUTH_SECRET=change-me-to-a-long-random-secret

# ---- App URL (Stripe redirects + public site) ----
# Local: http://localhost:3000
# Railway: https://YOUR-APP.up.railway.app  (set AFTER generating the domain)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Stripe (user payments → your account; you fund AI APIs separately) ----
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_xxxxxxxx
# Optional one-time credit pack
STRIPE_PRICE_ID_CREDITS=price_xxxxxxxx
# Dashboard webhook signing secret for production (not the local CLI whsec)
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx
STRIPE_CREDITS_PER_PACK=5
STRIPE_CREDIT_PACK_LABEL=$9.99 for 5 videos
# Optional: set "true" to enable Stripe automatic tax at checkout
# STRIPE_AUTOMATIC_TAX=false

# Creator / Lab subscription prices (test mode)
STRIPE_PRICE_ID_CREATOR_MONTHLY=price_xxxxxxxx
STRIPE_PRICE_ID_CREATOR_YEARLY=price_xxxxxxxx
STRIPE_PRICE_ID_LAB_MONTHLY=price_xxxxxxxx
STRIPE_PRICE_ID_LAB_YEARLY=price_xxxxxxxx

# ---- Unlimited accounts (owner / internal testers) ----
# These emails get unlimited video generation. Accounts are auto-created /
# password-synced on startup. Passwords must be at least 8 characters.
#
# Preferred: email:password pairs, comma-separated
# UNLIMITED_TEST_ACCOUNTS=you@example.com:ChooseAStrongPassword1
#
# Legacy fallback (one shared password for all listed emails). The password
# is required — no default is baked in, emails are skipped without it:
# UNLIMITED_TEST_EMAILS=tester@example.com
# UNLIMITED_TEST_PASSWORD=ChooseAStrongPassword1

# ---- Operator inbox (/ops) ----
# Comma-separated emails allowed to view production requests from /create.
# Must match the signed-in account. Example: you@example.com
OPERATOR_EMAILS=
